{
  "manifest_version": 3,
  "name": "Wild Themes for Microsoft 365",
  "short_name": "Wild Themes",
  "version": "2.5.0",
  "description": "Animated themes for Word, PowerPoint, Excel, Teams and Google Docs on the web, and a tool that saves a theme into any Word, PowerPoint or Excel file so everyone who opens it sees it.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wild Themes",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.officeapps.live.com/we/*",
        "https://*.officeapps.live.com/p/*",
        "https://*.officeapps.live.com/x/*",
        "https://word.cloud.microsoft/*",
        "https://powerpoint.cloud.microsoft/*",
        "https://excel.cloud.microsoft/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://assignments.edu.cloud.microsoft/*",
        "https://docs.google.com/document/*",
        "https://docs.google.com/spreadsheets/*",
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "lib/themes.js",
        "lib/perf.js",
        "lib/rewards.js",
        "cutscene.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://min3scon.github.io/Wild-Themes/*"
      ],
      "js": [
        "site-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "https://*.officeapps.live.com/*",
    "https://word.cloud.microsoft/*",
    "https://powerpoint.cloud.microsoft/*",
    "https://excel.cloud.microsoft/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://assignments.edu.cloud.microsoft/*",
    "https://docs.google.com/document/*",
    "https://docs.google.com/spreadsheets/*",
    "https://docs.google.com/presentation/*",
    "https://min3scon.github.io/*",
    "http://127.0.0.1:47615/*"
  ]
}
