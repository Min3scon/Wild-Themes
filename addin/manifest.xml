          <GetStarted><Title resid="GetStarted.Title"/><Description resid="GetStarted.Description"/><LearnMoreUrl resid="Site.Url"/></GetStarted>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="WildThemes.Group">
                <Label resid="Group.Label"/>
                <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                <Control xsi:type="Button" id="WildThemes.Open">
                  <Label resid="Button.Label"/>
                  <Supertip><Title resid="Button.Label"/><Description resid="Button.Tip"/></Supertip>
                  <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                  <Action xsi:type="ShowTaskpane"><TaskpaneId>WildThemes</TaskpaneId><SourceLocation resid="Taskpane.Url"/></Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
      </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://min3scon.github.io/Wild-Themes/addin/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://min3scon.github.io/Wild-Themes/addin/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://min3scon.github.io/Wild-Themes/addin/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://min3scon.github.io/Wild-Themes/addin/taskpane.html"/>
        <bt:Url id="Site.Url" DefaultValue="https://min3scon.github.io/Wild-Themes/addin/"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Wild Themes is ready"/>
        <bt:String id="Group.Label" DefaultValue="Wild Themes"/>
        <bt:String id="Button.Label" DefaultValue="Themes"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Open Home › Themes to apply, change, check or remove the theme saved in this file."/>
        <bt:String id="Button.Tip" DefaultValue="Apply, change, check or remove the theme saved in this file."/>
      </bt:LongStrings>
